<html>
<head>
<title>ContentDashboard</title>
</head>
<body>
<table cellpadding="1" cellspacing="1" border="1">
<thead>
<tr><td rowspan="1" colspan="3">ContentDashboard</td></tr>
</thead>
<tbody>
<tr>
	<td>FILTER_AND_ORDER_DROPDOWN</td>
	<td>//*[contains(@class, 'dropdown-toggle btn nav-link btn-unstyled')]</td>
	<td></td>
</tr>
<tr>
	<td>FILTER_BY_TAG_OPTION</td>
	<td>//*[contains(@class, 'dropdown-item') and contains(text(),'Tags')]</td>
	<td></td>
</tr>
<tr>
	<td>FILTER_BY_TITLE_OPTION</td>
	<td>//*[contains(@class, 'dropdown-item') and contains(text(),'Title')]</td>
	<td></td>
</tr>
<tr>
	<td>FIRST_CHECKBOX_TAGS</td>
	<td>//*[contains(@title,'Select') and contains(@value,'tag1')]</td>
	<td></td>
</tr>
<tr>
	<td>FIRST_ELEMENT_LISTED_BY_TAG</td>
	<td>//*[contains(@class, 'text-truncate') and contains(text(),'First')]</td>
	<td></td>
</tr>
<tr>
	<td>FIRST_ELEMENT_LISTED_BY_TITLE</td>
	<td>(//*[contains(@class, 'text-truncate')])[4]</td>
	<td></td>
</tr>
<tr>
	<td>REVERSE_SORT_DIRECTION_BUTTON</td>
	<td>(//*[contains(@class, 'lexicon-icon lexicon-icon-order-arrow')])</td>
	<td></td>
</tr>
<tr>
	<td>SECOND_CHECKBOX_TAGS</td>
	<td>//*[contains(@title,'Select') and contains(@value,'tag2')]</td>
	<td></td>
</tr>
<tr>
	<td>SECOND_ELEMENT_LISTED_BY_TAG</td>
	<td>//*[contains(@class, 'text-truncate') and contains(text(),'Second')]</td>
	<td></td>
</tr>
<tr>
	<td>SELECT_TAGS_BUTTON</td>
	<td>//*[contains(@id,'addButton') and contains(text(),'Select')]</td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>