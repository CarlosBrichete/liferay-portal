definition {

	@summary = "Basic Smoke test for the JSON WS API macros"
	macro runSmoke {
		JSONSegmentsentry.addSegment(
			fieldName = "Screen Name",
			groupName = "Test Site Name",
			operator = "not equals",
			segmentName = "First Segment",
			text = "Test");

		JSONSegmentsentry.addSegment(
			fieldName = "Email Address",
			groupName = "Test Site Name",
			operator = "not equals",
			segmentName = "Second Segment",
			text = "liferay.com");
	}

}